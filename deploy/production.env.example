FRONTEND_URL=https://codesight.app
VITE_SITE_URL=https://getcodesight.vercel.app
# Optional: set the token generated by Google Search Console URL-prefix verification.
# VITE_GOOGLE_SITE_VERIFICATION=
TRUST_PROXY=1
EXECUTOR_MODE=local
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
REQUEST_BODY_LIMIT=1mb
MAX_CODE_BYTES=524288
MAX_STDIN_BYTES=262144
EXECUTION_QUEUE_CONCURRENCY=2
EXECUTION_QUEUE_DEPTH_LIMIT=50
EXECUTION_MAX_OUTPUT_BYTES=4194304
EXECUTION_MEMORY_LIMIT_MB=512
EXECUTION_CPU_LIMIT=1
EXECUTION_PIDS_LIMIT=128
LOG_LEVEL=info
NODE_EXECUTABLE=node
PYTHON_EXECUTABLE=python
JAVA_EXECUTABLE=java
JAVAC_EXECUTABLE=javac
GCC_EXECUTABLE=gcc
GPP_EXECUTABLE=g++
EXECUTION_QUEUE_CONCURRENCY=2
EXECUTION_QUEUE_DEPTH_LIMIT=50
EXECUTION_MAX_OUTPUT_BYTES=1048576
EXECUTION_MEMORY_LIMIT_MB=512
EXECUTION_CPU_LIMIT=1
EXECUTION_PIDS_LIMIT=128
