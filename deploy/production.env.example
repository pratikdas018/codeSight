FRONTEND_URL=https://codesight.app
TRUST_PROXY=true
EXECUTOR_DOMAIN=executor.codesight.app
EXECUTOR_SHARED_SECRET=replace-with-a-long-random-secret
DOCKER_CONFIG_PATH=/root/.docker
REMOTE_EXECUTOR_TIMEOUT_MS=20000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_LEVEL=info
CODESIGHT_API_IMAGE=ghcr.io/prakitdas018/codesight-api:latest
CODESIGHT_EXECUTOR_IMAGE=ghcr.io/prakitdas018/codesight-executor:latest
NODE_EXECUTOR_IMAGE=ghcr.io/prakitdas018/codesight-node-runner:latest
PYTHON_EXECUTOR_IMAGE=ghcr.io/prakitdas018/codesight-python-runner:latest
CPP_EXECUTOR_IMAGE=ghcr.io/prakitdas018/codesight-cpp-runner:latest
JAVA_EXECUTOR_IMAGE=ghcr.io/prakitdas018/codesight-java-runner:latest
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_LIMIT=0.5
EXECUTION_PIDS_LIMIT=64
