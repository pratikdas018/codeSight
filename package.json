{
  "name": "codesight",
  "version": "1.0.0",
  "private": true,
  "description": "CodeSight full-stack MVP",
  "main": "electron/main.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npm run electron:dev\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "electron:dev": "wait-on http-get://127.0.0.1:4000/health http-get://127.0.0.1:5173 && electronmon .",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder",
    "docker:build": "docker build -f docker/Dockerfile.node -t codesight-node-runner . && docker build -f docker/Dockerfile.python -t codesight-python-runner . && docker build -f docker/Dockerfile.cpp -t codesight-cpp-runner . && docker build -f docker/Dockerfile.java -t codesight-java-runner .",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend"
  },
  "keywords": [
    "codesight",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.codesight.desktop",
    "productName": "CodeSight",
    "directories": {
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "backend/prisma/**/*",
      "backend/scripts/**/*",
      "backend/node_modules/**/*"
    ],
    "asarUnpack": [
      "backend/node_modules/.prisma/**/*",
      "backend/node_modules/@prisma/**/*",
      "backend/node_modules/bcrypt/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/assets/icon.png"
    }
  }
}
