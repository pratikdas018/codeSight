{
  "name": "codesight",
  "version": "1.0.2",
  "private": true,
  "description": "CodeSight full-stack MVP",
  "main": "electron/dist/main.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npm run electron:watch\" \"npm run electron:dev\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "electron:dev": "npm run build:electron && wait-on file:electron/dist/main.js file:electron/dist/preload.js http-get://127.0.0.1:4000/health http-get://127.0.0.1:5180 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5180 CODESIGHT_BACKEND_URL=http://127.0.0.1:4000 electron electron/dist/main.js",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "docker:build": "npm run docker:build:runners && npm run docker:build:api && npm run docker:build:executor",
    "docker:build:runners": "docker build -f docker/Dockerfile.node -t codesight-node-runner . && docker build -f docker/Dockerfile.python -t codesight-python-runner . && docker build -f docker/Dockerfile.cpp -t codesight-cpp-runner . && docker build -f docker/Dockerfile.java -t codesight-java-runner .",
    "docker:build:api": "docker build -f docker/Dockerfile.api -t codesight-api .",
    "docker:build:executor": "docker build -f docker/Dockerfile.executor -t codesight-executor .",
    "docker:compose:prod": "docker compose -f docker-compose.production.yml up -d"
  },
  "keywords": [
    "codesight",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "pino-http": "^11.0.0"
  },
  "build": {
    "appId": "com.codesight.desktop",
    "productName": "CodeSight",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/dist/**/*",
      "electron/desktop.config.json",
      "electron/splash.html",
      "electron/assets/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json"
    ],
    "extraMetadata": {
      "main": "electron/dist/main.js"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "prakitdas018",
        "repo": "codeSight",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "electron/assets/icon.ico"
    },
    "dmg": {
      "sign": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/assets/icon.png"
    }
  },
  "electronmon": {
    "patterns": [
      "!dist/**",
      "!dist/**/*",
      "!frontend-dev*.log",
      "!backend-dev*.log"
    ]
  }
}
