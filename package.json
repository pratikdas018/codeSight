{
  "name": "codesight",
  "version": "1.0.3",
  "private": true,
  "description": "CodeSight full-stack MVP",
  "main": "electron/dist/main.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "clean:release": "node -e \"require('node:fs').rmSync('release', { recursive: true, force: true })\"",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npm run electron:watch\" \"npm run electron:dev\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "electron:dev": "npm run build:electron && wait-on file:electron/dist/main.js file:electron/dist/preload.js http-get://127.0.0.1:4000/health http-get://127.0.0.1:5180 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5180 CODESIGHT_BACKEND_URL=http://127.0.0.1:4000 electron electron/dist/main.js",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run clean:release && npm run build && electron-builder"
  },
  "keywords": [
    "codesight",
    "monorepo"
  ],
  "author": {
    "name": "Pratik"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "rcedit": "^5.0.2",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "pino-http": "^11.0.0"
  },
  "build": {
    "appId": "com.pratik.codesight",
    "productName": "CodeSight",
    "copyright": "\u00A9 Pratik",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/dist/**/*",
      "electron/splash.html",
      "electron/assets/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json"
    ],
    "afterPack": "./electron/afterPack.mjs",
    "extraMetadata": {
      "main": "electron/dist/main.js"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "pratikdas018",
        "repo": "codeSight",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "electron/assets/icon.ico"
    },
    "dmg": {
      "sign": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/assets/icon.png"
    }
  },
  "electronmon": {
    "patterns": [
      "!dist/**",
      "!dist/**/*",
      "!frontend-dev*.log",
      "!backend-dev*.log"
    ]
  }
}
